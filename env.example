# Copy to .env.local (gitignored), and set the same values on the host.

# Public inbox shown on the site (the Gmail you can open)
NEXT_PUBLIC_ORDER_EMAIL=amoahinfotech@gmail.com
NEXT_PUBLIC_CONTACT_EMAIL=amoahinfotech@gmail.com

# Absolute URL of the deployed site. Dish photos in the emails and the return
# from the PaySwitch payment page are both built from it.
# SITE_URL=https://playman-lounge.vercel.app

# From-address for Brevo. Must be a sender you verified in the Brevo dashboard.
ORDER_FROM_NAME=Play Man Lounge
ORDER_FROM_EMAIL=amoahinfotech@gmail.com

# Kitchen copies (comma-separated). Customer always gets their own mail.
# Add playmanlounge@gmail.com here later if that inbox exists.
ORDER_STAFF_EMAILS=amoahinfotech@gmail.com

# Preferred: Brevo (300 emails/day free). Verify amoahinfotech@gmail.com as a sender, then paste the API key.
BREVO_API_KEY=

# Alternative: Resend. Without a verified domain, Resend only delivers to the account owner's inbox.
RESEND_API_KEY=
# RESEND_FROM=Play Man Lounge <onboarding@resend.dev>

# Mobile money through PaySwitch (theTeller). Leave these blank and the order
# form offers pay on delivery only. Server-side variables — never NEXT_PUBLIC_,
# and never committed.
THETELLER_API_USER=
THETELLER_API_KEY=
THETELLER_MERCHANT_ID=
# "test" hits test.theteller.net, "live" charges real wallets.
THETELLER_MODE=test
# "auto" tries the in-page mobile money prompt and falls back to the hosted
# PaySwitch page; "prompt" or "checkout" pin one path.
THETELLER_FLOW=auto
# Refuse online payment above this many cedis; bigger orders go by phone.
MAX_ORDER_TOTAL=5000

# Optional contact-form fallback (Make an Order no longer uses this)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
