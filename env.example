# Copy to .env.local (gitignored). Leave the key blank to use mailto: fallback.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_ORDER_EMAIL=hello@playmanlounge.gh
NEXT_PUBLIC_CONTACT_EMAIL=hello@playmanlounge.gh

# Where the payment service in payments/ is running. Leave it blank and the
# "Pay now with mobile money" option stays switched off. No PaySwitch key ever
# belongs in this file: they live as secrets on the payment service.
NEXT_PUBLIC_PAYMENT_API_URL=
